# ============================================================
# AlphaGameExplainer 环境配置模板
# 部署到新机器时：复制本文件为 .env，按注释填写，切勿把真实 .env 提交到 git
#   cp .env.example .env
# ============================================================

# ---------- LLM 后端（必填其一）----------
# 默认走 DeepSeek API。填入你自己的 key（https://platform.deepseek.com）
DEEPSEEK_API_KEY=在此填入你的_DeepSeek_API_Key
DEEPSEEK_MODEL=deepseek-v4-flash
# 如需自定义端点可取消下一行注释（默认 https://api.deepseek.com）
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# 后端选择：默认空=API 为主本地兜底；设 llama_cpp 强制纯本地（需下方模型路径）
# LLM_BACKEND=
LLM_TEMPERATURE=0.2

# ---------- 本地 llama.cpp 兜底（可选，无本地模型可留空）----------
# 只走 API 时留空即可；需要离线兜底时填入 GGUF 模型绝对路径
LLAMA_CPP_MODEL_PATH=
LLAMA_CPP_N_GPU_LAYERS=-1
LLAMA_CPP_N_CTX=4096
LLAMA_CPP_N_BATCH=512
LLAMA_CPP_VERBOSE=false

# ---------- Stockfish 引擎（必填）----------
# 相对路径会自动拼到项目根目录。仓库自带的是 Windows x64 AVX2 版；
# 换到 Linux/macOS 或非 AVX2 CPU 时，请替换为对应平台的 Stockfish 二进制并改此路径。
STOCKFISH_PATH=stockfish-windows-x86-64-avx2.exe

# ---------- Syzygy 残局表库（残局管线必需，3-6 子）----------
# 相对路径会自动拼到项目根目录
SYZYGY_PATH=syzygy

# ---------- FFmpeg（视频合成必需）----------
# 【跨机部署重点】留空则使用系统 PATH 中的 ffmpeg（推荐：把 ffmpeg 装进系统 PATH 后此处留空）。
# 若填写，必须是本机 ffmpeg 可执行文件的真实绝对路径，否则视频合成会失败。
FFMPEG_PATH=

# ---------- 输出与呈现 ----------
OUTPUT_DIR=./output
VIDEO_LAYOUT=vertical
TTS_RATE=180

# ---------- 解说词二次润色（off / detect / true）----------
ENABLE_POLISH=true

# ---------- 可选：HuggingFace 镜像（ChatTTS 首次下载模型慢时）----------
# HF_ENDPOINT=https://hf-mirror.com
